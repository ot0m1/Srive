# Copy to .env.local and fill in the two Spotify values.
#
# CLIENT_ID / CLIENT_SECRET come from the app in
# https://developer.spotify.com/dashboard
#
# That app needs a redirect URI registered that matches NEXTAUTH_URL:
#   <NEXTAUTH_URL>/api/auth/callback/spotify
#
# Spotify does not accept `localhost` as a redirect URI host. Use the loopback
# address literally:
#   http://127.0.0.1:3000/api/auth/callback/spotify
# Entries registered before the 2025 rule change are rejected too, at authorize
# time, with `INVALID_CLIENT: Insecure redirect URI`.
#
# NEXTAUTH_URL has to spell the host the same way, and you have to open the app
# on that host too.

CLIENT_ID=
CLIENT_SECRET=

NEXTAUTH_URL=http://127.0.0.1:3000
# Any random string. `openssl rand -base64 32` will do.
NEXTAUTH_SECRET=
